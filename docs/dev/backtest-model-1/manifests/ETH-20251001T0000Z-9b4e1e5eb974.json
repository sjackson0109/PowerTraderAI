    "low_move_mae_pct": "mean |predicted - actual| low move from bar j's close, %",
    "next_close_within_band_share": "share of active pairs whose next close lies in the predicted [low, high] band",
    "predicted_up_share_of_considered": "share of those where the predicted close move is up (1.0: the model always predicts a rise, so its hit rate is the up share)",
